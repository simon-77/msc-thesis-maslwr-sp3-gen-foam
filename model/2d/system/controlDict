FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     GeN-Foam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         3000;      // s; set by run.sh
deltaT          0.01;
adjustTimeStep  true;      // the time step follows the Courant number
maxCo           0.5;
maxDeltaT       1;
writeControl    adjustableRunTime;
writeInterval   100;       // s; set by run.sh
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression false;
timeFormat      general;
timePrecision   8;
runTimeModifiable true;

// Mass flow rate through the core outlet at every time step [kg/s]; the wedge is 1/180 of the vessel
functions
{
    mdot
    {
        type            massFlow;
        libs            ("libFFNFunctionObjects.so");
        region          fluid;
        regionType      faceZone;
        regionName      core_outlet;
        scaleFactor     180;
        alphaRhoPhiName "alphaRhoPhi";
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
}
