FoamFile { version 2.0; format ascii; class dictionary; object fvSchemes; }

// First order in time and for convection (upwind), as in the GeN-Foam tutorials.

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;
    div(alphaRhoPhi,U)                  Gauss upwind;
    div(alphaRhoPhi,he)                 Gauss upwind;
    div(alphaRhoPhi,K)                  Gauss upwind;
    div(alphaRhoPhiNu,U)                Gauss linear;
    div(alphaRhoPhi,k)                  Gauss upwind;
    div(alphaRhoPhi,epsilon)            Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear uncorrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         uncorrected;
}
