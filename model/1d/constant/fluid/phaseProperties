FoamFile { version 2.0; format ascii; class dictionary; object phaseProperties; }

// The six zones of the loop: flow area, wall friction, form losses, heating and cooling.
// GeN-Foam treats every zone as a porous medium: a cell is part water, part structure.

#include "$FOAM_CASE/constant/parameters"
#include "$FOAM_CASE/constant/step"      // power and T_sec of this run, written by run.sh

A_mesh  $A_dc_up;                                    // cross-section of the mesh [m^2]
z_cone  #eval{ 0.5*($z_cone_bot + $z_cone_top) };    // the cone is a step at its mid-height
L_core      #eval{ $z_core_top - $z_bot };
L_riser_up  #eval{ $z_top - $z_cone };
L_sg        #eval{ $z_top - $z_sg_bot };

// Smooth-wall friction (Blasius), used by the zones below
blasius { type ReynoldsPower; coeff $f_coeff; exp $f_exp; }

// --- Heating: the core power, uniform over the water in the core [W/m^3] ---
fluidProperties
{
    initialPowerDensity
    {
        "core"  #eval{ $power/($A_core*$L_core) };
    }
}

// --- Flow area and hydraulic diameter of each zone ---
// volumeFraction is the part of the mesh cross-section that is not open to the flow.
structureProperties
{
    "core"      { volumeFraction #eval{ 1 - $A_core/$A_mesh };      Dh $Dh_core; }
    "riser_low" { volumeFraction #eval{ 1 - $A_riser_low/$A_mesh }; Dh $Dh_riser_low; }
    "riser_up"  { volumeFraction #eval{ 1 - $A_riser_up/$A_mesh };  Dh $Dh_riser_up; }
    "sg"
    {
        volumeFraction #eval{ 1 - $A_sg/$A_mesh };
        Dh $Dh_sg;
        // Cooling: the inner surface of the tubes is at T_sec. Tube area per volume of mesh [1/m]:
        powerModel
        {
            type            fixedTemperature;
            volumetricArea  #eval{ $A_tubes/($A_mesh*$L_sg) };
            T               $T_sec;
        }
    }
    "dc_up"     { volumeFraction 0;                                 Dh $Dh_dc_up; }
    "dc_low"    { volumeFraction #eval{ 1 - $A_dc_low/$A_mesh };    Dh $Dh_dc_low; }
}

regimeMapModels
{
}

physicsModels
{
    // --- Pressure losses ---
    // Friction factor of a zone: f = coeff Re^exp + const. A form loss K is spread over the
    // length L of its zone as the constant K Dh / L (then f L / Dh gives K).
    dragModels
    {
        "core"      { $blasius; const #eval{ ($K_plate + $K_grid + $K_rods + $K_core_out)*$Dh_core/$L_core }; }
        "riser_low" { $blasius; }
        "riser_up"  { $blasius; const #eval{ ($K_flowmeter + $K_riser_out)*$Dh_riser_up/$L_riser_up }; }
        // K_bundle is on the velocity in A_bundle; on the velocity in the SG zone: (A_sg / A_bundle)^2
        "sg"        { type ReynoldsPower; coeff 0; exp 0;
                      const #eval{ $f_sg + $K_bundle*pow($A_sg/$A_bundle, 2)*$Dh_sg/$L_sg }; }
        "dc_up"     { $blasius; }
        "dc_low"    { $blasius; }
    }

    // --- Heat transfer coefficient between the water and the SG tubes [W/(m^2 K)] ---
    heatTransferModels
    {
        "sg" { type constant; value $U_sg; }
    }

    pairGeometryModels
    {
    }
}
